# -------------------------------------------------------
# HubSpot KB → Markdown Converter — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your values.

# Path to the folder where you place your input file(s) (CSV, Excel, or HTML).
INPUT_DIR=input

# Path to the folder where converted .md files will be saved.
OUTPUT_DIR=output

# Path to the folder where downloaded media files (images, videos, docs) are saved.
MEDIA_DIR=output/media_files

# Set to "true" to download images and media referenced in articles to MEDIA_DIR.
DOWNLOAD_MEDIA=true

# (Optional) Set to "true" to auto-create a dated sub-folder (e.g. output/2026-03-17/)
USE_DATED_SUBFOLDER=false

# (Optional) Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
