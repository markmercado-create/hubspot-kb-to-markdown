# -------------------------------------------------------
# HubSpot KB → Markdown Converter — Environment Variables
# -------------------------------------------------------
# Copy this file to .env and fill in your values.

# Path to the folder where you place the exported HubSpot CSV file(s).
INPUT_DIR=input

# Path to the folder where converted .md files will be saved.
OUTPUT_DIR=output

# (Optional) Sub-folder name inside OUTPUT_DIR to organise exports by run date.
# Set to "true" to auto-create a dated sub-folder (e.g. output/2026-03-17/)
USE_DATED_SUBFOLDER=false

# (Optional) Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
